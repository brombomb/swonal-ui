# swonal-ui Environment Configuration
PORT=3000
DATABASE_URL="file:./data/swonal.db"

# Optional Public / Reverse-Proxy Base URL (e.g. https://swonal.brombomb.com)
# Used for Companion QR code and default Spotify OAuth callback URL
PUBLIC_URL=""

# Hardware Bridge Endpoint (use ws://tonal-daemon-mock:8765/ws in Docker mock mode,
# or ws://<TONAL_TABLET_IP>:8765/ws when pointing to a rooted Tonal V1 tablet)
TONAL_DAEMON_URL="http://localhost:8765"
TONAL_DAEMON_WS_URL="ws://localhost:8765/ws"

# Spotify OAuth 2.0 Credentials (optional — simulated local playback works without keys)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# Headless Plexamp Player URL (optional, e.g. http://192.168.1.50:32500)
PLEXAMP_URL=""

# Self-Hosted Exercise Form Media Directory (defaults to /data/media or ./packages/server-app/data/media)
MEDIA_DIR=""

# Home Assistant MQTT & Webhook Event Bus (optional)
MQTT_BROKER_URL=""
MQTT_TOPIC_PREFIX="swonal"
MQTT_USERNAME=""
MQTT_PASSWORD=""
HA_WEBHOOK_URL=""
HA_WEBHOOK_TOKEN=""
