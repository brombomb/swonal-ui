# swonal-ui Environment Configuration
PORT=3000
DATABASE_URL="file:./data/swonal.db"

# Hardware Bridge Endpoint (use ws://tonal-daemon-mock:8765/ws in Docker mock mode,
# or ws://<TONAL_TABLET_IP>:8765/ws when pointing to a rooted Tonal V1 tablet)
TONAL_DAEMON_URL="http://localhost:8765"
TONAL_DAEMON_WS_URL="ws://localhost:8765/ws"

# Spotify OAuth 2.0 Credentials (optional — simulated local playback works without keys)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/music/spotify/callback"
