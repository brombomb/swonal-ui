# swonal-ui Optional Power-User Home / Cloud Sync Server Environment Configuration
# Note: The Android Kiosk APK now runs 100% Standalone out of the box (on-device SQLite + :3000 Companion).
# Deploy server-app ONLY if you want always-on 24/7 MCP workout queuing, automated off-device SQLite backups,
# multi-device web access, or centralized Home Assistant MQTT discovery.
PORT=3000
DATABASE_URL="file:./data/swonal.db"

# Automatic rotating SQLite backup directory (optional, defaults to packages/server-app/prisma/data/backups)
SWONAL_BACKUP_DIR=""

# Optional Public / Reverse-Proxy Base URL (e.g. https://swonal.example.com or http://192.168.1.100:3000)
# Used for Companion QR code and default Spotify OAuth callback URL
PUBLIC_URL=""

# Optional Hardware Bridge Endpoint:
# Leave localhost or point ws://<TONAL_IP>:8765/ws only for local desktop mock testing;
# synced Standalone Kiosk tablets stream telemetry directly to the server over /ws/sync!
TONAL_DAEMON_URL="http://localhost:8765"
TONAL_DAEMON_WS_URL="ws://localhost:8765/ws"
# Optional shared bearer token to authenticate non-loopback requests to tonal-daemon (:8765)
DAEMON_API_TOKEN=""

# Spotify OAuth 2.0 Credentials (optional — simulated local playback works without keys)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# Headless Plexamp & Plex Media Server (optional, can also be configured in /settings)
PLEXAMP_URL=""
PLEX_SERVER_URL=""
PLEX_TOKEN=""

# YouTube Music Desktop API Server (th-ch/youtube-music plugin :26538) or HA media_player
YTM_API_URL=""
YTM_AUTH_TOKEN=""
YTM_HA_ENTITY_ID=""

# Apple Music Library API & Home Assistant media_player (Apple TV / HomePod / AirPlay)
APPLE_MUSIC_DEVELOPER_TOKEN=""
APPLE_MUSIC_USER_TOKEN=""
APPLE_MUSIC_HA_ENTITY_ID=""

# Amazon Music via Home Assistant media_player (Echo / Sonos / WiiM / Music Assistant)
AMAZON_MUSIC_HA_ENTITY_ID=""

# Self-Hosted Exercise Form Media Directory (defaults to /data/media or ./packages/server-app/data/media)
MEDIA_DIR=""

# Home Assistant MQTT Auto-Discovery, Webhook Event Bus, & Core REST API (optional, configurable in /settings)
MQTT_BROKER_URL=""
MQTT_TOPIC_PREFIX="swonal"
MQTT_USERNAME=""
MQTT_PASSWORD=""
HA_WEBHOOK_URL=""
HA_WEBHOOK_TOKEN=""
HA_URL=""
HA_TOKEN=""

# AI Voice Coach BYOK Providers (optional, configurable & persisted in /settings)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_URL=""

# Optional Internet Access Passcode Lock (can also be configured in /settings)
SWONAL_AUTH_PASSCODE=""
SWONAL_API_TOKEN=""
SWONAL_SESSION_SECRET=""
